{
  "name": "@mzy1120/http",
  "version": "0.0.0",
  "description": "@mzy1120 专属请求库:基于 axios 的统一封装(业务信封解包 / 防重复 / 并发熔断 / 全局反馈适配器,RESTful 语义化方法)+ 多接口编排(MultiApiTask / BatchProcessor / DataLoaderService,细粒度进度 / 整体取消 / 单接口重试),零 UI 依赖,可注入 antd/ElementPlus 等",
  "keywords": [
    "mzy1120",
    "request",
    "axios",
    "http",
    "restful",
    "fetch",
    "orchestrator",
    "MultiApiTask",
    "BatchProcessor",
    "DataLoaderService"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  }
}
