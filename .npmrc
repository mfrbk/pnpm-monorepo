# =============================================================================
# 默认使用 npm 公共源
# =============================================================================
registry=https://registry.npmjs.org/

# -----------------------------------------------------------------------------
# 企业私有源发包(二选一,临时切换,勿长期写入此处):
#
# 方式一:命令附带 --registry
#   pnpm --filter @mfr/utils publish --registry=https://your-registry.example.com
#
# 方式二:环境变量注入(changeset publish / pnpm publish 均生效)
#   npm_config_registry=https://your-registry.example.com pnpm run release:publish
#
# 私有源通常还需要认证配置,请参考对应制品库(Verdaccio / Nexus / JFrog)文档。
# -----------------------------------------------------------------------------

# workspace 内部包使用 workspace: 协议,发包时 pnpm 会自动改写为真实版本
link-workspace-packages=true
prefer-workspace-packages=true
